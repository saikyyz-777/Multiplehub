local function clampPos(pos)
    local abs  = mainFrame.AbsoluteSize
    local ss   = workspace.CurrentCamera.ViewportSize
    local anch = abs * mainFrame.AnchorPoint
    return UDim2.new(0,
        math.clamp(pos.X.Offset, anch.X + 5, ss.X - abs.X + anch.X - 5),
        0,
        math.clamp(pos.Y.Offset, anch.Y + 5, ss.Y - abs.Y + anch.Y - 5)
    )
end

local function updateDrag(input)
    local delta   = input.Position - dragStart
    local raw     = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    local clamped = clampPos(raw)
    tween(mainFrame, {Position = clamped}, 0.06)
    task.wait()
    syncGlows()
end

