local function createTab(name, icon, frame, order)
    local btn = Instance.new("TextButton", tabBar)
    btn.Size             = UDim2.new(0, 110, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(0,0,0)
    btn.BackgroundTransparency = 1
    btn.Text             = icon .. " " .. name
    btn.TextColor3       = C.text_dim
    btn.Font             = Enum.Font.GothamBold
    btn.TextSize         = 13
    btn.BorderSizePixel  = 0
    btn.ZIndex           = 2
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    addRipple(btn)

    btn.MouseButton1Click:Connect(function()
        farmFrame.Visible   = false
        configFrame.Visible = false
        infoFrame.Visible   = false
        frame.Visible       = true

        for _, c in ipairs(tabBar:GetChildren()) do
            if c:IsA("TextButton") then tween(c, {TextColor3 = C.text_dim}, 0.2) end
        end
        tween(btn, {TextColor3 = C.text_white}, 0.2)

        local tabBarWidth = tabBar.AbsoluteSize.X
        local totalBtns   = 3*110 + 2*4
        local leftMargin  = (tabBarWidth - totalBtns) / 2
        local targetX     = leftMargin + (order - 1) * (110 + 4)
        tween(tabIndicator, {Position = UDim2.new(0, targetX, 0, 5)}, 0.3)

        local colors = {C.accent_blue, C.accent_purple, C.accent_gold}
        tween(tabIndicator, {BackgroundColor3 = colors[order]}, 0.3)
        local stroke = tabIndicator:FindFirstChildWhichIsA("UIStroke")
        if stroke then tween(stroke, {Color = colors[order]}, 0.3) end

        activeTabBtn = btn
    end)

    btn.MouseEnter:Connect(function()
        if btn ~= activeTabBtn then tween(btn, {TextColor3 = Color3.fromRGB(200,200,230)}, 0.15) end
    end)
    btn.MouseLeave:Connect(function()
        if btn ~= activeTabBtn then tween(btn, {TextColor3 = C.text_dim}, 0.15) end
    end)

    return btn
end

