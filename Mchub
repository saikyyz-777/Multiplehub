local ProfileSystem = {}
ProfileSystem.profiles = {}
ProfileSystem.currentProfile = "Default"

function ProfileSystem:SaveProfiles()
    if not writefile then return end
    pcall(function()
        writefile(profilesFileName, game:GetService("HttpService"):JSONEncode(self.profiles))
    end)
end

function ProfileSystem:LoadProfiles()
    if not isfile or not readfile then return end
    if isfile(profilesFileName) then
        local ok, res = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(profilesFileName))
        end)
        if ok and res then self.profiles = res; return true end
    end
    return false
end

function ProfileSystem:CreateProfile(name)
    if self.profiles[name] then return false end
    local defFlex = {}
    for i = 1, 20 do defFlex[i] = true end
    self.profiles[name] = {
        mobNames = {}, mobFlexible = defFlex, mobDistance = 5,
        tpwalkSpeed = 80, jpower = 110, infJumpEnabled = true
    }
    self:SaveProfiles(); return true
end

function ProfileSystem:SaveCurrentProfile()
    self.profiles[self.currentProfile] = {
        mobNames = mobNames, mobFlexible = mobFlexible,
        mobDistance = mobDistance, tpwalkSpeed = tpwalkSpeed,
        jpower = jpower, infJumpEnabled = infJumpEnabled
    }
    self:SaveProfiles()
end

function ProfileSystem:LoadProfile(name)
    if not self.profiles[name] then return false end
    local p = self.profiles[name]
    mobNames = p.mobNames or {}
    mobFlexible = p.mobFlexible or {}
    for i = 1, 20 do if mobFlexible[i] == nil then mobFlexible[i] = true end end
    mobDistance = p.mobDistance or 5
    tpwalkSpeed = p.tpwalkSpeed or 80
    jpower = p.jpower or 110
    infJumpEnabled = p.infJumpEnabled ~= nil and p.infJumpEnabled or true
    self.currentProfile = name; return true
end

function ProfileSystem:DeleteProfile(name)
    if name == "Default" or not self.profiles[name] then return false end
    self.profiles[name] = nil
    if self.currentProfile == name then self.currentProfile = "Default"; self:LoadProfile("Default") end
    self:SaveProfiles(); return true
end

function ProfileSystem:GetProfileNames()
    local names = {}
    for n in pairs(self.profiles) do table.insert(names, n) end
    table.sort(names); return names
end

ProfileSystem:LoadProfiles()
if not ProfileSystem.profiles["Default"] then ProfileSystem:CreateProfile("Default") end

