-- ════════════════════════════════════════════════════════════════
local spinnerFrames = {"⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"}
local function buttonSpinner(btn, originalText, duration)
    local running = true
    local i = 1
    task.spawn(function()
        while running do
            btn.Text = spinnerFrames[i] .. " Carregando..."
            i = i % #spinnerFrames + 1
            task.wait(0.08)
        end
        btn.Text = originalText
    end)
    task.delay(duration or 1, function() running = false end)
end

