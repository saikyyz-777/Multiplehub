-- HELPERS DE TWEEN
-- ════════════════════════════════════════════════════════════════
local function tween(obj, props, t, style, dir)
    local ti = TweenInfo.new(t or 0.3, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(obj, ti, props)
    tw:Play()
    return tw
end

local function tweenBack(obj, props, t)    return tween(obj, props, t, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end
local function tweenBounce(obj, props, t)  return tween(obj, props, t, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out) end
local function tweenElastic(obj, props, t) return tween(obj, props, t, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out) end
local function tweenSine(obj, props, t)    return tween(obj, props, t, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut) end
local function tweenExp(obj, props, t)     return tween(obj, props, t, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out) end

