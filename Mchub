-- [CORRIGIDO] Flag única para o glow do farm — sem multiplicação de loops
local farmGlowActive = false

local function updateFarmToggle()
    local col = autoRaid and C.on_color or C.off_color
    tween(farmTrack, {BackgroundColor3 = col}, 0.25)
    tween(farmTrkStroke, {Color = col}, 0.25)
    tween(farmKnob, {Position = autoRaid and UDim2.new(1,-27,0,3) or UDim2.new(0,3,0,3)}, 0.3, Enum.EasingStyle.Back)
    farmStateLbl.Text = autoRaid and "ON" or "OFF"
    farmStateLbl.TextXAlignment = autoRaid and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
    farmIconLbl.TextColor3 = autoRaid and C.on_color or C.text_dim
    if farmToggleStroke then tween(farmToggleStroke, {Color = autoRaid and C.on_color or C.border_dim}, 0.25) end

    farmGlowActive = autoRaid
    if autoRaid then
        task.spawn(function()
            while farmGlowActive and farmTrkStroke.Parent do
                tweenSine(farmTrkStroke, {Transparency = 0.1}, 0.7)
                task.wait(0.7)
                tweenSine(farmTrkStroke, {Transparency = 0.6}, 0.7)
                task.wait(0.7)
            end
        end)
    end
end

farmClickBtn.MouseButton1Click:Connect(function()
    autoRaid = not autoRaid
    updateFarmToggle()
    if autoRaid then
        stats.isRunning    = true
        stats.startTime    = tick()
        stats.sessionKills = 0
        createNotification("⚔️ Farm Ativado", "Multiple Farm iniciado!", 2, C.on_color)
    else
        stats.isRunning = false
