    slotBg.Position         = UDim2.new(0, 10, 0, yOff)
    slotBg.BackgroundColor3 = Color3.fromRGB(22, 22, 38)
    slotBg.BorderSizePixel  = 0
    Instance.new("UICorner", slotBg).CornerRadius = UDim.new(0, 10)
    addStroke(slotBg, C.border_dim, 1, 0.3)

    local numLbl = Instance.new("TextLabel", slotBg)
    numLbl.Size               = UDim2.new(0, 22, 0, 22)
    numLbl.Position           = UDim2.new(0, 4, 0, 4)
    numLbl.BackgroundColor3   = C.bg_card
    numLbl.BackgroundTransparency = 0.3
    numLbl.Text               = tostring(idx)
    numLbl.TextColor3         = C.text_muted
    numLbl.Font               = Enum.Font.GothamBold
    numLbl.TextSize           = 10
    Instance.new("UICorner", numLbl).CornerRadius = UDim.new(0, 5)

    local box = Instance.new("TextBox", slotBg)
    box.Size             = UDim2.new(1, -30, 0, 28)
    box.Position         = UDim2.new(0, 28, 0, 2)
    box.BackgroundColor3 = C.bg_input
    box.TextColor3       = C.text_white
    box.Font             = Enum.Font.GothamBold
    box.TextSize         = 13
    box.PlaceholderText  = "Nome do mob " .. idx .. "..."
    box.PlaceholderColor3 = C.text_muted
    box.Text             = mobNames[idx] or ""
    box.BorderSizePixel  = 0
    box.ClearTextOnFocus = false
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)
    local boxStroke = addStroke(box, C.border_dim, 1, 0.4)

    box.Focused:Connect(function()
        tween(boxStroke, {Color = C.accent_orange, Transparency = 0}, 0.2)
        local slbStk = slotBg:FindFirstChildWhichIsA("UIStroke")
        if slbStk then tween(slbStk, {Color = C.accent_orange, Transparency = 0}, 0.2) end
        numLbl.TextColor3 = C.accent_orange
    end)
    box.FocusLost:Connect(function()
        tween(boxStroke, {Color = C.border_dim, Transparency = 0.4}, 0.2)
        local slbStk = slotBg:FindFirstChildWhichIsA("UIStroke")
        if slbStk then tween(slbStk, {Color = C.border_dim, Transparency = 0.3}, 0.2) end
        numLbl.TextColor3 = C.text_muted
        mobNames[idx]     = box.Text
        saveConfig()
    end)

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        if query == "" then
            slotBg.Visible = true
        else
            local name = string.lower(mobNames[idx] or "")
            slotBg.Visible = string.find(name, query, 1, true) ~= nil or string.find(tostring(idx), query, 1, true) ~= nil
        end
    end)

    local flexBtn = Instance.new("TextButton", slotBg)
    flexBtn.Size             = UDim2.new(0.5, -2, 0, 24)
    flexBtn.Position         = UDim2.new(0, 0, 0, 35)
    flexBtn.Font             = Enum.Font.GothamBold
    flexBtn.TextSize         = 10
    flexBtn.Text             = "🔄 Flexível"
    flexBtn.TextColor3       = C.text_white
    flexBtn.BorderSizePixel  = 0
    Instance.new("UICorner", flexBtn).CornerRadius = UDim.new(0, 6)
    addRipple(flexBtn)

    local exactBtn = Instance.new("TextButton", slotBg)
    exactBtn.Size             = UDim2.new(0.5, -2, 0, 24)
    exactBtn.Position         = UDim2.new(0.5, 2, 0, 35)
    exactBtn.Font             = Enum.Font.GothamBold
    exactBtn.TextSize         = 10
    exactBtn.Text             = "🎯 Exato"
    exactBtn.TextColor3       = C.text_white
    exactBtn.BorderSizePixel  = 0
    Instance.new("UICorner", exactBtn).CornerRadius = UDim.new(0, 6)
    addRipple(exactBtn)

    local FLEX_C  = Color3.fromRGB(30, 80, 180)
    local EXACT_C = Color3.fromRGB(160, 70, 20)
    local DIM_C   = Color3.fromRGB(35, 35, 55)

    local function updateFlex()
        if mobFlexible[idx] then
            tween(flexBtn,  {BackgroundColor3 = FLEX_C}, 0.2)
            tween(exactBtn, {BackgroundColor3 = DIM_C},  0.2)
        else
            tween(flexBtn,  {BackgroundColor3 = DIM_C},   0.2)
            tween(exactBtn, {BackgroundColor3 = EXACT_C}, 0.2)
        end
    end
    updateFlex()

    flexBtn.MouseButton1Click:Connect(function()
        mobFlexible[idx] = true
        updateFlex(); saveConfig()
    end)
    exactBtn.MouseButton1Click:Connect(function()
        mobFlexible[idx] = false
        updateFlex(); saveConfig()
    end)

    mobInputs[idx]   = box
    mobFlexBtns[idx] = { flex = flexBtn, exact = exactBtn, update = updateFlex }
end

