-- [CORRIGIDO] Config Toggles com flag única de glow
local function makeConfigToggle(parent, label, icon, initial, order, color)
    local card = makeCard(parent, 54, order)
    local cs   = card:FindFirstChildWhichIsA("UIStroke")
    local state = { value = initial }
    local glowActive = false

    local iconLbl = Instance.new("TextLabel", card)
    iconLbl.Size               = UDim2.new(0, 30, 0, 30)
    iconLbl.Position           = UDim2.new(0, 10, 0, 12)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Text               = icon
    iconLbl.Font               = Enum.Font.GothamBold
    iconLbl.TextSize           = 20
    iconLbl.TextColor3         = initial and color or C.text_muted

    local lbl = Instance.new("TextLabel", card)
    lbl.Size               = UDim2.new(0.6, 0, 1, 0)
    lbl.Position           = UDim2.new(0, 46, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text               = label
    lbl.TextColor3         = C.text_white
    lbl.Font               = Enum.Font.GothamBold
    lbl.TextSize           = 14
    lbl.TextXAlignment     = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", card)
    track.Size             = UDim2.new(0, 60, 0, 28)
    track.Position         = UDim2.new(1, -76, 0, 13)
    track.BackgroundColor3 = initial and color or C.off_color
    track.BackgroundTransparency = 0.3
    track.BorderSizePixel  = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local trkStroke = addStroke(track, initial and color or C.off_color, 1.5, 0.4)

    local knob = Instance.new("Frame", track)
    knob.Size             = UDim2.new(0, 22, 0, 22)
    knob.Position         = initial and UDim2.new(1,-25,0,3) or UDim2.new(0,3,0,3)
    knob.BackgroundColor3 = C.text_white
    knob.BorderSizePixel  = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local stateLbl = Instance.new("TextLabel", track)
    stateLbl.Size               = UDim2.new(1, 0, 1, 0)
    stateLbl.BackgroundTransparency = 1
    stateLbl.Text               = initial and "ON" or "OFF"
    stateLbl.TextColor3         = C.text_white
    stateLbl.Font               = Enum.Font.GothamBold
    stateLbl.TextSize           = 9
    stateLbl.TextXAlignment     = initial and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
    local sp = Instance.new("UIPadding", stateLbl)
    sp.PaddingLeft = UDim.new(0,5); sp.PaddingRight = UDim.new(0,5)

    local clickBtn = Instance.new("TextButton", card)
    clickBtn.Size               = UDim2.new(1, 0, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text               = ""
    clickBtn.ZIndex             = 5
    addRipple(clickBtn)

    local function updateVis()
        local c2 = state.value and color or C.off_color
        tween(track, {BackgroundColor3 = c2}, 0.25)
        tween(trkStroke, {Color = c2}, 0.25)
        tween(knob, {Position = state.value and UDim2.new(1,-25,0,3) or UDim2.new(0,3,0,3)}, 0.28, Enum.EasingStyle.Back)
        stateLbl.Text = state.value and "ON" or "OFF"
        stateLbl.TextXAlignment = state.value and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
        iconLbl.TextColor3 = state.value and color or C.text_muted
        if cs then tween(cs, {Color = state.value and color or C.border_dim}, 0.25) end

        glowActive = state.value
        if state.value then
            task.spawn(function()
                while glowActive and trkStroke.Parent do
                    tweenSine(trkStroke, {Transparency = 0.1}, 0.8)
                    task.wait(0.8)
                    tweenSine(trkStroke, {Transparency = 0.6}, 0.8)
                    task.wait(0.8)
                end
            end)
        end
    end

    if initial then
        task.defer(function()
            glowActive = true
            task.spawn(function()
                while glowActive and trkStroke.Parent do
                    tweenSine(trkStroke, {Transparency = 0.1}, 0.8)
                    task.wait(0.8)
                    tweenSine(trkStroke, {Transparency = 0.6}, 0.8)
                    task.wait(0.8)
                end
            end)
        end)
    end

    return clickBtn, state, updateVis
end

