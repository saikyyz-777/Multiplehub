local function spawnParticle()
    if activeParticles >= MAX_PARTICLES then return end
    activeParticles += 1
    local p = Instance.new("Frame", mainFrame)
    local size = math.random(2, 5)
    p.Size             = UDim2.new(0, size, 0, size)
    p.Position         = UDim2.new(math.random(), 0, 1, math.random(0, 20))
    p.BackgroundColor3 = particleColors[math.random(#particleColors)]
    p.BackgroundTransparency = math.random(40, 75) / 100
    p.BorderSizePixel  = 0
    p.ZIndex           = 2
    Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
    local duration = math.random(5, 12)
    local targetX  = p.Position.X.Scale + (math.random() - 0.5) * 0.3
    tween(p, {
        Position = UDim2.new(targetX, 0, -0.05, 0),
        BackgroundTransparency = 1
    }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, function()
        activeParticles -= 1
        if p and p.Parent then p:Destroy() end
    end)
end

