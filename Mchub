local function equipTool()
    local bp = player:FindFirstChild("Backpack")
    if bp then
        local tool = bp:FindFirstChildWhichIsA("Tool")
        if tool then tool.Parent = character end
    end
end

local function findMob(mobName, isFlexible)
    if mobName == "" then return nil end
    local objFolder = workspace:FindFirstChild("Objects")
    if not objFolder then return nil end
    local sn = string.lower(mobName)
    for _, mob in ipairs(objFolder:GetChildren()) do
        local mn = string.lower(mob.Name)
        if isFlexible then
            if string.find(mn, sn, 1, true) then return mob end
        else
            if mn == sn then return mob end
        end
    end
    return nil
end

-- [CORRIGIDO] attackMob com desconexão garantida e timeout de 30s
local function attackMob(mobName, isFlexible, slotIdx)
    local mob = findMob(mobName, isFlexible)
    if mob then
        stats.currentMob = mob.Name
        local part = mob.PrimaryPart or mob:FindFirstChildWhichIsA("BasePart")
        if part then
            equipTool()
            local conn
            conn = RunService.RenderStepped:Connect(function()
                if not autoRaid or not mob or not mob.Parent then
                    conn:Disconnect()
                    conn = nil
                    return
                end
                pcall(function()
                    humanoidRootPart.CFrame = part.CFrame * CFrame.new(0, 5, -mobDistance)
                    remote:FireServer("Attack", mob)
                end)
            end)
            local timeout = tick() + 30
            repeat
                task.wait(0.2)
            until not mob or not mob.Parent or not autoRaid or tick() > timeout

            if conn then conn:Disconnect(); conn = nil end

            if not mob or not mob.Parent then
                stats.sessionKills += 1
                stats.totalKills   += 1
                killCountLbl.Text   = stats.sessionKills .. " kills"
                tween(killCountLbl, {TextColor3 = C.accent_gold}, 0.1)
                tweenBounce(killCountLbl, {TextSize = 15}, 0.15)
                task.wait(0.3)
                tween(killCountLbl, {TextSize = 13}, 0.2)
            elseif tick() > timeout then
                createNotification("⚠️ Timeout", mobName .. " não morreu em 30s!", 2, C.accent_orange)
            end
        end
    else
        stats.currentMob = "Procurando..."
        task.wait(0.5)
    end
end

task.spawn(function()
